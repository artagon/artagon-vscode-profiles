{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rust: doc",
      "type": "shell",
      "command": "cargo doc --workspace --all-features --no-deps",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "rust: doc strict",
      "type": "shell",
      "command": "env RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --all-features --no-deps",
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
