// Shared C/C++ + CMake + CodeLLDB workspace settings (auto core count, matching rust lldb.*).
{
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.generator": "Ninja",
  "cmake.preferredGenerators": ["Ninja"],
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.configureOnOpen": true,
  "cmake.configureOnEdit": true,
  "cmake.saveBeforeBuild": true,
  "cmake.buildBeforeRun": true,
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  "cmake.loggingLevel": "warning",
  "cmake.parallelJobs": 0,
  "cmake.ctest.allowParallelJobs": true,
  "cmake.ctest.parallelJobs": 0,

  "lldb.displayFormat": "auto",
  "lldb.dereferencePointers": true,
  "lldb.showDisassembly": "never",
  "lldb.suppressMissingSourceFiles": true,
  "lldb.launch.terminal": "integrated",
  "lldb.evaluationTimeout": 10,

  "files.watcherExclude": {
    "**/build/**": true,
    "**/cmake-build-*/**": true,
    "**/.vscode/ipch/**": true
  },
  "search.exclude": {
    "**/build/**": true,
    "**/cmake-build-*/**": true,
    "**/.vscode/ipch/**": true
  },

  "[cpp]": {
    "editor.tabSize": 4,
    "editor.rulers": [100]
  },
  "[c]": {
    "editor.tabSize": 4,
    "editor.rulers": [100]
  },
  "[cmake]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [100]
  }
}
