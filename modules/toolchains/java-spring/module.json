{
  "version": 1,
  "id": "java-spring",
  "kind": "toolchain",
  "description": "Spring Boot framework layer (layers cleanly with either java-gradle or java-maven)",
  "requires": ["java-base"],
  "defaultWith": [],
  "conflicts": [],
  "extensions": {
    "workspace": [
      "vmware.vscode-spring-boot",
      "vscjava.vscode-spring-boot-dashboard",
      "vscjava.vscode-spring-initializr"
    ],
    "profile": [],
    "unwanted": [
      "pivotal.vscode-spring-boot",
      "vscjava.vscode-spring-cloud"
    ]
  },
  "settings": {
    "workspace": "settings.workspace.jsonc",
    "profile": null
  },
  "tasks": null,
  "detect": {
    "priority": 35,
    "fallback": false,
    "match": "any",
    "supersedes": [],
    "rules": [
      {
        "type": "file_and_grep",
        "paths": ["build.gradle", "build.gradle.kts", "pom.xml"],
        "search_dir": "src/main/java",
        "glob": "*Application.java",
        "pattern": "@SpringBootApplication"
      }
    ]
  }
}
