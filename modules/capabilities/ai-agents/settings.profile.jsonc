// Coexistence settings for Google Antigravity (default agent) + Claude Code + OpenAI Codex + GitHub Copilot Chat.
// Google Antigravity leads agent workflows with cumulative diff reviews; Copilot Chat owns
// inline ghost-text completions and Next Edit Suggestions without provider collisions;
// Claude Code and Codex run quietly as secondary panels without onboarding or CodeLens noise.
// Note: Antigravity telemetry is managed in Antigravity Settings -> Account (enableTelemetry is deprecated in 1.13.0).
{
  "antigravity.keybindingScheme": "vscode",
  "antigravity.enableInlineDiff": true,
  "antigravity.autoAcceptOnChat": false,
  "antigravity.autoOpenFiles": false,
  "antigravity.enableComments": true,

  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.fontFamily": "'Monaspace Krypton NF', 'Monaspace Krypton', 'Maple Mono NF', 'JetBrains Mono', Menlo, monospace",
  "editor.inlineSuggest.edits.showCollapsed": false,
  "editor.inlineSuggest.edits.allowCodeShifting": "always",
  "editor.inlineSuggest.edits.renderSideBySide": "auto",
  "editor.quickSuggestions": {
    "other": "offWhenInlineCompletions",
    "comments": "off",
    "strings": "off"
  },

  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "github.copilot.editor.enableCodeActions": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.nextEditSuggestions.fixes": true,
  "github.copilot.nextEditSuggestions.extendedRange": true,
  "github.copilot.renameSuggestions.triggerAutomatically": true,

  "chat.agent.enabled": true,
  "chat.detectParticipant.enabled": true,
  "chat.useAgentsMdFile": true,
  "chat.useNestedAgentsMdFiles": true,
  "chat.useClaudeMdFile": true,
  "chat.useAgentSkills": true,
  "chat.editor.fontSize": 13,
  "chat.editor.lineHeight": 20,
  "chat.tools.compressOutput.enabled": true,
  "chat.tools.riskAssessment.enabled": true,
  "chat.tools.terminal.outputReflow": true,
  "chat.tools.autoExpandFailures": true,
  "chat.notifyWindowOnResponseReceived": "windowNotFocused",
  "inlineChat.askInChat": true,

  "chatgpt.openOnStartup": false,
  "chatgpt.commentCodeLensEnabled": false,
  "chatgpt.followUpQueueMode": "queue",
  "chatgpt.composerEnterBehavior": "cmdIfMultiline",
  "chatgpt.reviewDelivery": "inline",
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.respectGitIgnore": true,
  "claudeCode.autosave": true,
  "claudeCode.lockEditorGroups": false,
  "claudeCode.hideOnboarding": true
}
