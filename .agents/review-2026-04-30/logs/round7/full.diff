+    [ -L "$link" ] || fail "Expected symlink at $link (was a regular file — pattern broken)"
+    target="$(readlink "$link")"
+    expected="${stack}-base.jsonc"
+    [ "$target" = "$expected" ] || fail "Expected $link -> $expected, got $target"
+  done
+done
