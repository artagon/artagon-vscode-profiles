#!/usr/bin/env bash
# pre-commit — Repository validation & artifact-sync pre-commit hook.
# Does NOT require VS Code CLI (`code`) on PATH so pure config edits work anywhere.
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${0}")" && pwd -P)"
if [[ -n "${VSPCLI_ROOT:-}" ]]; then
  ROOT="${VSPCLI_ROOT}"
elif [[ -n "${GIT_DIR:-}" ]] && command -v git >/dev/null 2>&1 && git_top="$(git rev-parse --show-toplevel 2>/dev/null)" && [[ -n "${git_top}" ]]; then
  ROOT="${git_top}"
else
  ROOT="$(CDPATH='' cd -- "${SCRIPT_DIR}/../.." && pwd -P)"
fi

run() {
  local description="${1}"
  shift
  echo "pre-commit: ${description}"
  "${@}"
}

run "validating catalog, modules, and profiles" "${BASH}" "${ROOT}/scripts/vspcli" validate
run "rebuilding composed settings, extensions, and exports" "${BASH}" "${ROOT}/scripts/vspcli" build

# Check git porcelain independently (never mask git failures with `|| true`).
if ! status_out="$(git -C "${ROOT}" status --porcelain --untracked-files=all -- _merged/ profiles/ exports/)"; then
  echo "pre-commit: git status failed" >&2
  exit 1
fi

dirty=""
dirty_re='^(\?\?|.[A-Z?!]|DD|AU|UD|UA|DU|AA|UU)'
LC_ALL=C
while IFS= read -r line; do
  [[ -n "${line}" ]] || continue
  # Reject:
  #   - untracked files: `??`
  #   - any non-space worktree column (M, D, T, A, R, C, ?, !): `^.[A-Z?!]`
  #   - any unmerged conflict state: DD, AU, UD, UA, DU, AA, UU
  # Allows purely staged index changes like `M  _merged/rust.json` or `A  exports/ai.code-profile`.
  if [[ "${line}" =~ ${dirty_re} ]]; then
    if [[ -z "${dirty}" ]]; then
      dirty="${line}"
    else
      dirty="${dirty}"$'\n'"${line}"
    fi
  fi
done <<< "${status_out}"

if [[ -n "${dirty}" ]]; then
  cat >&2 <<EOF
pre-commit: vspcli build regenerated files that are unstaged, untracked, or conflicted.

Affected:
${dirty}

Run 'bash scripts/vspcli build', stage the updated _merged/, profiles/, and exports/
files ('git add _merged/ profiles/ exports/'), and commit again.
EOF
  exit 1
fi
