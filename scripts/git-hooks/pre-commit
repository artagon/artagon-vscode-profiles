#!/usr/bin/env bash
# pre-commit — Repository validation & generated-artifact guard pre-commit hook.
# Does NOT require VS Code CLI (`code`) on PATH so pure config edits work anywhere.
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${0}")" && pwd -P)"
if [[ -n "${VSPCLI_ROOT:-}" ]]; then
  ROOT="${VSPCLI_ROOT}"
elif [[ -n "${GIT_DIR:-}" ]] && command -v git >/dev/null 2>&1 && git_top="$(git rev-parse --show-toplevel 2>/dev/null)" && [[ -n "${git_top}" ]]; then
  ROOT="${git_top}"
else
  ROOT="$(CDPATH='' cd -- "${SCRIPT_DIR}/../.." && pwd -P)"
fi

run() {
  local description="${1}"
  shift
  echo "pre-commit: ${description}"
  "${@}"
}

# 1. Collect staged files (Added/Copied/Modified/Renamed) and reject generated artifacts.
staged_files=""
if [[ -e "${ROOT}/.git" ]] && command -v git >/dev/null 2>&1; then
  if ! staged_files="$(git -C "${ROOT}" diff --cached --name-only --diff-filter=ACMR)"; then
    echo "pre-commit: git diff --cached failed" >&2
    exit 1
  fi
fi

forbidden_staged=""
need_rust_check=0
if [[ -n "${staged_files}" ]]; then
  while IFS= read -r path; do
    [[ -n "${path}" ]] || continue
    case "${path}" in
      _merged/*|exports/*|profiles/*/extensions.json|profiles/*/settings.json)
        if [[ -z "${forbidden_staged}" ]]; then
          forbidden_staged="${path}"
        else
          forbidden_staged="${forbidden_staged}"$'\n'"${path}"
        fi
        ;;
    esac
    case "${path}" in
      Cargo.toml|Cargo.lock|crates/*|catalog/*|packs/*|presets.jsonc|vsp.lock.json)
        need_rust_check=1
        ;;
    esac
  done <<< "${staged_files}"
fi

if [[ -n "${forbidden_staged}" ]]; then
  cat >&2 <<EOF
pre-commit: refusing to commit generated artifacts (built on demand since v2.2.0):

${forbidden_staged}

Unstage these paths ('git reset HEAD -- _merged exports profiles/*/extensions.json profiles/*/settings.json')
and commit only source files (packs/, presets.jsonc, catalog/, vsp.lock.json, modules/, profiles/*/profile.json).
EOF
  exit 1
fi

# 2. Validate catalog, packs, modules, presets, lockfile, and security invariants.
run "validating catalog, modules, packs, and profiles" env VSPCLI_ROOT="${ROOT}" "${BASH}" "${ROOT}/scripts/validate-json.sh"

# 3. ShellCheck bin/vsp when shellcheck is available.
if [[ -f "${ROOT}/bin/vsp" ]] && command -v shellcheck >/dev/null 2>&1; then
  run "shellchecking bin/vsp" shellcheck --exclude=SC1091 "${ROOT}/bin/vsp"
fi

# 4. Run Rust tests and v2.2 catalog validation when cargo is available and relevant files are staged.
if [[ "${need_rust_check}" -eq 1 && -f "${ROOT}/Cargo.toml" ]] && command -v cargo >/dev/null 2>&1; then
  run "running cargo test --workspace" cargo test --manifest-path "${ROOT}/Cargo.toml" --workspace
  run "running vsp dev validate" cargo run --quiet --manifest-path "${ROOT}/Cargo.toml" --bin vsp -- --catalog "${ROOT}" dev validate
fi
