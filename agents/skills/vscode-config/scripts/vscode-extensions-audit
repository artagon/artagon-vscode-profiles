#!/usr/bin/env bash
#
# vscode-extensions-audit — audit a .vscode/extensions.json against an allowed list.
#
# Reports:
#   - Recommended extensions NOT on the allowed list (potential policy violation)
#   - Allowed extensions NOT recommended (informational; may be expected)
#   - IDs that appear in both recommendations and unwantedRecommendations (logical contradiction)
#   - Allowed-list members that are explicitly unwanted (also a contradiction)
#
# Reminder: extensions.json is a SUGGESTION mechanism — it does not enforce installation.
# For real enforcement, use VS Code's enterprise AllowedExtensions policy (see the skill's
# precedence.md "Enterprise policies" section).
#
# Usage:
#   vscode-extensions-audit --allowed <allowed-list-file> <extensions.json>
#   vscode-extensions-audit --allowed-inline "id1,id2,..." <extensions.json>
#
# The allowed-list file format: one extension ID per line. Blank lines and lines starting
# with # are ignored.
#
# Exit codes:
#   0 — extensions.json fully complies with the allowed list
#   1 — violations found (extensions recommended that aren't allowed, or contradictions)
#   2 — usage error
#   3 — file invalid (delegate parsing to vscode-jsonc-validate would be ideal; we
#       just report unparseable here)

set -eu

# Force C locale so `comm`, `sort`, etc. behave deterministically.
# Set differences via `comm` require byte-stable collation.
export LC_ALL=C

# shellcheck disable=SC1007
# `CDPATH= cd` is the deliberate "neutralize CDPATH for this one cd" idiom from
# the Google Shell Style Guide; ShellCheck's SC1007 misreads it as an empty assign.
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
STRIPPER="${SCRIPT_DIR}/jsonc-strip.awk"

# Source the shared NUL-byte guard. Done before any command substitution that
# would silently truncate at the first NUL byte. See lib/nul-check.sh for why
# this guard lives in shell rather than inside jsonc-strip.awk.
# shellcheck source=./lib/nul-check.sh
. "${SCRIPT_DIR}/lib/nul-check.sh"

usage() {
    cat >&2 <<EOF
usage: vscode-extensions-audit (--allowed <file> | --allowed-inline <csv>) [--quiet] <extensions.json>

Audits .vscode/extensions.json against an allowed list of extension IDs.

  --allowed <file>          Path to a file with one ID per line (# comments allowed).
  --allowed-inline <csv>    Comma-separated list of allowed IDs.
  --quiet                   Only print violations (no informational sections).
  -h, --help                Show this message.

Exit 0 = clean, 1 = violations, 2 = usage, 3 = unparseable extensions.json.
EOF
    exit 2
}

ALLOWED_FILE=""
ALLOWED_INLINE=""
QUIET=0
FILE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --allowed)         shift; [ $# -gt 0 ] || usage; ALLOWED_FILE="$1" ;;
        --allowed=*)       ALLOWED_FILE="${1#--allowed=}" ;;
        --allowed-inline)  shift; [ $# -gt 0 ] || usage; ALLOWED_INLINE="$1" ;;
        --allowed-inline=*) ALLOWED_INLINE="${1#--allowed-inline=}" ;;
        --quiet|-q)        QUIET=1 ;;
        -h|--help)         usage ;;
        --)                shift; FILE="${1:-}"; break ;;
        -*)                echo "ERROR: unknown option: $1" >&2; usage ;;
        *)
            if [ -z "$FILE" ]; then FILE="$1"
            else echo "ERROR: extra argument: $1" >&2; usage; fi
            ;;
    esac
    shift
done

[ -n "$FILE" ] || usage
[ -f "$FILE" ] || { echo "ERROR: file not found: $FILE" >&2; exit 2; }

if [ -n "$ALLOWED_FILE" ] && [ -n "$ALLOWED_INLINE" ]; then
    echo "ERROR: pass --allowed OR --allowed-inline, not both" >&2
    usage
fi
if [ -z "$ALLOWED_FILE" ] && [ -z "$ALLOWED_INLINE" ]; then
    echo "ERROR: must pass --allowed or --allowed-inline" >&2
    usage
fi
if [ -n "$ALLOWED_FILE" ] && [ ! -f "$ALLOWED_FILE" ]; then
    echo "ERROR: allowed list not found: $ALLOWED_FILE" >&2
    exit 2
fi

command -v jq >/dev/null 2>&1 || { echo "ERROR: jq is required" >&2; exit 2; }
[ -f "$STRIPPER" ] || { echo "ERROR: stripper not found: $STRIPPER" >&2; exit 2; }

# Build the allowed list as a sorted, deduped, newline-separated stream.
# Strip CR (handles CRLF line endings from Windows-edited files) and trim whitespace.
if [ -n "$ALLOWED_FILE" ]; then
    ALLOWED="$(tr -d '\r' < "$ALLOWED_FILE" | grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$' | awk '{$1=$1; print}' | sort -u)"
else
    ALLOWED="$(printf '%s' "$ALLOWED_INLINE" | tr ',' '\n' | tr -d '\r' | awk '{$1=$1; print}' | grep -v '^$' | sort -u)"
fi

# Reject raw NUL bytes BEFORE the awk command substitution silently truncates
# them. See scripts/lib/nul-check.sh for the rationale.
nul_check_file "$FILE" || exit 3

# Parse extensions.json. Wrap in explicit failure handler — `set -eu` does NOT
# fail the script when the right-hand side of a command substitution exits
# non-zero (POSIX behavior; bash needs `inherit_errexit`).
if ! STRIPPED="$(awk -f "$STRIPPER" < "$FILE")"; then
    echo "ERROR: $FILE: jsonc-strip.awk failed; see prior stderr for details" >&2
    exit 3
fi
if ! printf '%s' "$STRIPPED" | jq empty 2>/dev/null; then
    echo "ERROR: $FILE is not valid JSONC. Run vscode-jsonc-validate for details." >&2
    exit 3
fi

# Input-shape contracts (R1-01/R1-02/R1-04). The audit is the policy gate; clean
# exit 0 on attacker-controlled wrong-shape input would defeat the contract. Same
# class of failure as the NUL-byte bypass — different vector. We require:
#   - root is a JSON object (not [...])
#   - recommendations + unwantedRecommendations, when present, are arrays of strings
# `jq -e` exits 1 on false; we surface that as exit 1 (violation) with a clear
# error so CI parsers don't see a swallowed jq stack trace.
if ! printf '%s' "$STRIPPED" | jq -e 'type == "object"' >/dev/null 2>&1; then
    echo "ERROR: $FILE: extensions.json root must be a JSON object (got $(printf '%s' "$STRIPPED" | jq -r 'type'))" >&2
    exit 1
fi
if ! printf '%s' "$STRIPPED" | jq -e '(.recommendations // []) | type == "array" and all(type == "string")' >/dev/null 2>&1; then
    echo "ERROR: $FILE: \"recommendations\" must be an array of strings" >&2
    exit 1
fi
if ! printf '%s' "$STRIPPED" | jq -e '(.unwantedRecommendations // []) | type == "array" and all(type == "string")' >/dev/null 2>&1; then
    echo "ERROR: $FILE: \"unwantedRecommendations\" must be an array of strings" >&2
    exit 1
fi

RECOMMENDED="$(printf '%s' "$STRIPPED" | jq -r '(.recommendations // []) | .[]' | sort -u)"
UNWANTED="$(printf '%s' "$STRIPPED" | jq -r '(.unwantedRecommendations // []) | .[]' | sort -u)"

# Compute set differences via comm. comm needs sorted input; we already sorted.
NOT_ALLOWED="$(comm -23 <(printf '%s\n' "$RECOMMENDED" | grep -v '^$' || true) <(printf '%s\n' "$ALLOWED" | grep -v '^$' || true))"
NOT_RECOMMENDED="$(comm -13 <(printf '%s\n' "$RECOMMENDED" | grep -v '^$' || true) <(printf '%s\n' "$ALLOWED" | grep -v '^$' || true))"
IN_BOTH="$(comm -12 <(printf '%s\n' "$RECOMMENDED" | grep -v '^$' || true) <(printf '%s\n' "$UNWANTED" | grep -v '^$' || true))"
ALLOWED_BUT_UNWANTED="$(comm -12 <(printf '%s\n' "$ALLOWED" | grep -v '^$' || true) <(printf '%s\n' "$UNWANTED" | grep -v '^$' || true))"

EXIT=0
HAS_VIOLATION=0

if [ -n "$NOT_ALLOWED" ]; then
    echo "VIOLATION: extensions recommended but not on allowed list:"
    printf '%s\n' "$NOT_ALLOWED" | sed 's/^/  /'
    HAS_VIOLATION=1
fi

if [ -n "$IN_BOTH" ]; then
    echo "VIOLATION: extensions in both recommendations and unwantedRecommendations:"
    printf '%s\n' "$IN_BOTH" | sed 's/^/  /'
    HAS_VIOLATION=1
fi

if [ -n "$ALLOWED_BUT_UNWANTED" ]; then
    echo "VIOLATION: allowed-list extensions explicitly marked unwanted:"
    printf '%s\n' "$ALLOWED_BUT_UNWANTED" | sed 's/^/  /'
    HAS_VIOLATION=1
fi

[ "$HAS_VIOLATION" -eq 1 ] && EXIT=1

if [ "$QUIET" -eq 0 ]; then
    if [ -n "$NOT_RECOMMENDED" ]; then
        echo "INFO: allowed extensions not in recommendations (may be intentional):"
        printf '%s\n' "$NOT_RECOMMENDED" | sed 's/^/  /'
    fi
    if [ "$EXIT" -eq 0 ]; then
        REC_COUNT="$(printf '%s\n' "$RECOMMENDED" | grep -c . || true)"
        echo "OK: $FILE — $REC_COUNT recommended extension(s), all on allowed list"
    fi
fi

exit "$EXIT"
