// Consolidated v2.2 pack: cpp-base (toolchain)
{
  "version": 2,
  "id": "cpp-base",
  "kind": "toolchain",
  "description": "Shared C/C++ CMake Tools, CodeLLDB debugger, and syntax highlighting (portable, zero hardcoded host paths)",
  "requires": [
    "core-editor"
  ],
  "defaultWith": [],
  "conflicts": [],
  "extensions": {
    "workspace": [
      "ms-vscode.cmake-tools",
      "vadimcn.vscode-lldb",
      "jeff-hykin.better-cpp-syntax"
    ],
    "profile": [],
    "unwanted": [
      "twxs.cmake",
      "ms-vscode.cpptools-extension-pack"
    ]
  },
  "settings": {
    // Shared C/C++ + CMake + CodeLLDB workspace settings (auto core count, matching rust lldb.*).
    "workspace": {
      "cmake.buildDirectory": "${workspaceFolder}/build",
      "cmake.generator": "Ninja",
      "cmake.preferredGenerators": ["Ninja"],
      "cmake.sourceDirectory": "${workspaceFolder}",
      "cmake.configureOnOpen": true,
      "cmake.configureOnEdit": true,
      "cmake.saveBeforeBuild": true,
      "cmake.buildBeforeRun": true,
      "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
      "cmake.loggingLevel": "warning",
      "cmake.parallelJobs": 0,
      "cmake.ctest.allowParallelJobs": true,
      "cmake.ctest.parallelJobs": 0,

      "lldb.displayFormat": "auto",
      "lldb.dereferencePointers": true,
      "lldb.showDisassembly": "never",
      "lldb.suppressMissingSourceFiles": true,
      "lldb.launch.terminal": "integrated",
      "lldb.evaluationTimeout": 10,

      "files.watcherExclude": {
        "**/build/**": true,
        "**/cmake-build-*/**": true,
        "**/.vscode/ipch/**": true
      },
      "search.exclude": {
        "**/build/**": true,
        "**/cmake-build-*/**": true,
        "**/.vscode/ipch/**": true
      },

      "[cpp]": {
        "editor.tabSize": 4,
        "editor.rulers": [100]
      },
      "[c]": {
        "editor.tabSize": 4,
        "editor.rulers": [100]
      },
      "[cmake]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.rulers": [100]
      }
    },
    "profile": null
  },
  "tasks": null,
  "detect": null
}
