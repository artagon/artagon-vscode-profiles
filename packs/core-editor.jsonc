// Consolidated v2.2 pack: core-editor (capability)
{
  "version": 2,
  "id": "core-editor",
  "kind": "capability",
  "description": "Slim core editor ergonomics, universal data-format tooling (JSON/YAML/TOML/XML/CSV/DotEnv/EditorConfig), Error Lens, spell checking, and pinned crisp/retina theme packs",
  "requires": [],
  "defaultWith": [],
  "conflicts": [],
  "extensions": {
    "workspace": [
      "editorconfig.editorconfig",
      "tamasfe.even-better-toml",
      "dotenv.dotenv-vscode",
      "redhat.vscode-yaml"
    ],
    "profile": [
      "redhat.vscode-xml",
      "mechatroner.rainbow-csv",
      "usernamehw.errorlens",
      "streetsidesoftware.code-spell-checker",
      "enkia.tokyo-night",
      "pkief.material-icon-theme",
      "pkief.material-product-icons",
      "catppuccin.catppuccin-vsc",
      "catppuccin.catppuccin-vsc-icons",
      "miguelsolorio.fluent-icons"
    ],
    "unwanted": [
      "mikestead.dotenv"
    ]
  },
  "settings": {
    // Core workspace-safe project settings (no personal UX, no machine/application keys).
    // Provides universal validation, SchemaStore auto-completion, and formatting for JSON/JSONC,
    // YAML, TOML, and INI/Properties across all 15 compiled profiles and workspaces.
    // (XML workspace settings live in java-base where redhat.vscode-xml is workspace-recommended,
    // and in core-editor/settings.profile.jsonc for all 15 compiled profiles.)
    "workspace": {
      "editor.hover.enabled": "on",
      "editor.hover.delay": 200,
      "editor.parameterHints.enabled": true,
      "editor.parameterHints.cycle": true,
      "editor.tabSize": 2,
      "files.trimTrailingWhitespace": true,
      "files.insertFinalNewline": true,
      "files.exclude": {
        "**/.DS_Store": true,
        "**/Thumbs.db": true
      },
      "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/.cache/**": true
      },
      "search.exclude": {
        "**/node_modules/**": true,
        "**/.cache/**": true
      },

      "json.validate.enable": true,
      "json.format.enable": true,
      "json.schemaDownload.enable": true,
      "json.maxItemsComputed": 5000,
      "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },

      "yaml.validate": true,
      "yaml.completion": true,
      "yaml.hover": true,
      "yaml.hoverSchemaSource": true,
      "yaml.schemaStore.enable": true,
      "yaml.format.enable": true,
      "yaml.format.printWidth": 100,
      "yaml.format.singleQuote": false,
      "yaml.format.bracketSpacing": true,
      "yaml.format.proseWrap": "preserve",
      "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },

      "evenBetterToml.schema.enabled": true,
      "evenBetterToml.syntax.semanticTokens": true,
      "evenBetterToml.formatter.indentString": "  ",
      "evenBetterToml.formatter.columnWidth": 100,
      "evenBetterToml.formatter.arrayTrailingComma": true,
      "evenBetterToml.formatter.trailingNewline": true,
      "evenBetterToml.formatter.allowedBlankLines": 1,
      "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
        "editor.formatOnSave": true
      },

      "[ini]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[properties]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    // Core profile/user ergonomics (disjoint from the 15 symmetric UX keys in modules/ux/).
    // Note: telemetry.telemetryLevel, security.workspace.trust.untrustedFiles,
    // update.mode, update.showReleaseNotes, window.titleBarStyle, window.nativeTabs,
    // window.autoDetectHighContrast, catppuccin.*, and antigravity.keybindingScheme
    // are APPLICATION-scoped in VS Code 1.147.0 (effective from the Default profile).
    // workbench.welcomePage.walkthroughs.openOnInstall is MACHINE-scoped.
    "profile": {
      "workbench.list.smoothScrolling": true,
      "workbench.list.defaultFindMode": "filter",
      "workbench.list.defaultFindMatchType": "fuzzy",
      "workbench.tree.renderIndentGuides": "always",
      "workbench.tree.expandMode": "doubleClick",
      "workbench.tree.enableStickyScroll": true,
      "workbench.tree.stickyScrollMaxItemCount": 5,
      "workbench.editor.highlightModifiedTabs": true,
      "workbench.editor.revealIfOpen": true,
      "workbench.editor.limit.enabled": true,
      "workbench.editor.limit.value": 10,
      "workbench.editor.limit.excludeDirty": true,
      "workbench.editor.limit.perEditorGroup": true,
      "workbench.localHistory.enabled": true,
      "workbench.localHistory.maxFileEntries": 50,
      "workbench.sideBar.location": "left",
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "workbench.welcomePage.walkthroughs.openOnInstall": false,

      "window.commandCenter": true,
      "window.titleBarStyle": "custom",
      "window.nativeTabs": false,
      "window.autoDetectHighContrast": true,

      "update.mode": "manual",
      "update.showReleaseNotes": false,
      "extensions.ignoreRecommendations": false,

      "terminal.integrated.gpuAcceleration": "on",
      "terminal.integrated.enableImages": true,
      "terminal.integrated.macOptionIsMeta": true,
      "terminal.integrated.macOptionClickForcesSelection": true,
      "terminal.integrated.smoothScrolling": true,
      "terminal.integrated.lineHeight": 1.2,
      "terminal.integrated.minimumContrastRatio": 4.5,
      "terminal.integrated.fontLigatures.enabled": true,
      "terminal.integrated.fontLigatures.featureSettings": "\"calt\" on, \"zero\" on",
      "terminal.integrated.stickyScroll.enabled": true,
      "terminal.integrated.stickyScroll.maxLineCount": 3,
      "terminal.integrated.cursorStyle": "line",
      "terminal.integrated.cursorStyleInactive": "outline",
      "terminal.integrated.cursorWidth": 2,
      "terminal.integrated.cursorBlinking": false,
      "terminal.integrated.scrollback": 10000,
      "terminal.integrated.tabs.enabled": true,
      "terminal.integrated.shellIntegration.enabled": true,
      "terminal.integrated.shellIntegration.decorationsEnabled": "gutter",
      "terminal.integrated.shellIntegration.quickFixEnabled": true,
      "terminal.integrated.suggest.enabled": true,
      "terminal.integrated.suggest.upArrowNavigatesHistory": true,
      "terminal.integrated.suggest.showStatusBar": true,
      "terminal.integrated.suggest.selectionMode": "partial",
      "terminal.integrated.suggest.inlineSuggestion": "alwaysOnTopExceptExactMatch",

      "editor.fontWeight": "400",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.cursorBlinking": "expand",
      "editor.cursorSurroundingLines": 5,
      "editor.smoothScrolling": true,
      "editor.padding.top": 8,
      "editor.padding.bottom": 12,
      "editor.scrollbar.verticalScrollbarSize": 10,
      "editor.scrollbar.horizontalScrollbarSize": 10,
      "editor.overviewRulerBorder": false,
      "editor.stickyScroll.enabled": true,
      "editor.stickyScroll.maxLineCount": 5,
      "editor.stickyScroll.defaultModel": "outlineModel",
      "editor.guides.bracketPairs": "active",
      "editor.guides.highlightActiveIndentation": true,
      "editor.guides.indentation": true,
      "editor.bracketPairColorization.enabled": true,
      "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
      "editor.linkedEditing": true,
      "editor.foldingImportsByDefault": true,
      "editor.occurrencesHighlight": "multiFile",
      "editor.lightbulb.enabled": "onCode",
      "editor.multiCursorModifier": "alt",
      "editor.rename.enablePreview": true,
      "editor.smartSelect.selectSubwords": true,
      "editor.gotoLocation.multipleDefinitions": "goto",
      "editor.gotoLocation.multipleImplementations": "goto",
      "editor.gotoLocation.multipleReferences": "peek",
      "editor.renderLineHighlight": "all",
      "editor.renderWhitespace": "selection",
      "editor.minimap.enabled": true,
      "editor.minimap.autohide": "mouseover",
      "editor.minimap.maxColumn": 80,
      "editor.minimap.showSlider": "mouseover",
      "editor.minimap.renderCharacters": false,
      "editor.inlineSuggest.enabled": true,
      "editor.inlineSuggest.showToolbar": "onHover",
      "editor.inlineSuggest.syntaxHighlightingEnabled": true,
      "editor.inlineSuggest.suppressSuggestions": false,
      "editor.codeLens": true,
      "editor.inlayHints.enabled": "onUnlessPressed",
      "editor.inlayHints.padding": true,
      "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
      },
      "editor.quickSuggestionsDelay": 10,
      "editor.suggestSelection": "recentlyUsedByPrefix",
      "editor.acceptSuggestionOnEnter": "smart",
      "editor.acceptSuggestionOnCommitCharacter": true,
      "editor.snippetSuggestions": "bottom",
      "editor.tabCompletion": "off",
      "editor.wordBasedSuggestions": "offWithInlineSuggestions",
      "editor.suggest.insertMode": "replace",
      "editor.suggest.matchOnWordStartOnly": false,
      "editor.suggest.filterGraceful": true,
      "editor.suggest.preview": true,
      "editor.suggest.showStatusBar": true,
      "editor.suggest.localityBonus": true,
      "editor.suggest.shareSuggestSelections": true,
      "editor.stickyTabStops": true,
      "editor.accessibilitySupport": "off",

      "debug.inlineValues": "on",
      "search.smartCase": true,
      "search.followSymlinks": false,
      "search.useIgnoreFiles": true,
      "scm.defaultViewMode": "tree",
      "scm.diffDecorations": "all",
      "scm.graph.showIncomingChanges": true,
      "scm.graph.showOutgoingChanges": true,
      "problems.showCurrentInStatus": true,
      "diffEditor.experimental.showMoves": true,
      "diffEditor.hideUnchangedRegions.enabled": true,
      "diffEditor.useInlineViewWhenSpaceIsLimited": true,
      "git.autofetch": false,
      "git.fetchOnPull": true,
      "git.pruneOnFetch": true,
      "git.confirmSync": false,
      "git.enableSmartCommit": true,
      "git.mergeEditor": true,
      "git.openRepositoryInParentFolders": "prompt",
      "git.blame.editorDecoration.enabled": false,

      "errorLens.enabledDiagnosticLevels": ["error", "warning"],
      "errorLens.messageMaxChars": 160,
      "errorLens.delay": 500,
      "errorLens.delayMode": "new",
      "errorLens.messageBackgroundMode": "message",
      "errorLens.fontStyleItalic": true,
      "errorLens.padding": "1px 6px",
      "errorLens.borderRadius": "3px",

      "catppuccin.accentColor": "mauve",
      "catppuccin.workbenchMode": "flat",
      "catppuccin.bracketMode": "neovim",
      "catppuccin.italicComments": true,
      "catppuccin.italicKeywords": true,
      "catppuccin.boldKeywords": true,
      "catppuccin.extraBordersEnabled": false,
      "catppuccin.syncWithIconPack": true,
      "catppuccin-icons.hidesExplorerArrows": true,
      "catppuccin-icons.specificFolders": true,
      "catppuccin-icons.monochrome": false,

      "material-icon-theme.hidesExplorerArrows": true,
      "material-icon-theme.activeIconPack": "none",
      "material-icon-theme.folders.theme": "specific",
      "material-icon-theme.saturation": 0.85,

      "redhat.telemetry.enabled": false,
      "xml.server.preferBinary": true,
      "xml.validation.enabled": true,
      "xml.validation.noGrammar": "hint",
      "xml.format.enabled": true,
      "xml.format.maxLineWidth": 100,
      "xml.completion.autoCloseTags": true,
      "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "rainbow_csv.enable_sticky_header": true,
      "rainbow_csv.enable_tooltip_column_names": true,
      "rainbow_csv.virtual_alignment_mode": "manual",

      "security.workspace.trust.untrustedFiles": "prompt",
      "breadcrumbs.enabled": true,
      "explorer.sortOrder": "foldersNestsFiles",
      "explorer.confirmDelete": true,
      "explorer.confirmDragAndDrop": false,
      "explorer.compactFolders": true,
      "explorer.autoReveal": "focusNoScroll",
      "explorer.autoRevealExclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/target": true,
        "**/.venv": true,
        "**/dist": true,
        "**/build": true,
        "**/.gradle": true
      },
      "explorer.excludeGitIgnore": false,
      "explorer.incrementalNaming": "smart",
      "explorer.openEditors.visible": 5,
      "explorer.copyRelativePathSeparator": "/",
      "explorer.decorations.colors": true,
      "explorer.decorations.badges": true,
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.expand": false,
      "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.js.map, ${capture}.d.ts, ${capture}.d.ts.map",
        "*.tsx": "${capture}.js, ${capture}.js.map, ${capture}.d.ts, ${capture}.d.ts.map",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js.map",
        "tsconfig.json": "tsconfig.*.json, jsconfig.json, jsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, pnpm-workspace.yaml, bun.lockb, bun.lock, .npmrc, .nvmrc, .node-version, .yarnrc*, biome.json, biome.jsonc, eslint.config.*, .eslintrc*, .eslintignore, prettier.config.*, .prettierrc*, .prettierignore",
        "Cargo.toml": "Cargo.lock, rust-toolchain.toml, rust-toolchain, rustfmt.toml, .rustfmt.toml, clippy.toml, .clippy.toml, deny.toml, cross.toml",
        "pyproject.toml": "uv.lock, poetry.lock, pdm.lock, Pipfile, Pipfile.lock, requirements*.txt, setup.cfg, .python-version, ruff.toml, .ruff.toml, pyrightconfig.json, mypy.ini, .mypy.ini, pytest.ini, tox.ini, .flake8, .coveragerc",
        "pom.xml": "mvnw, mvnw.cmd",
        "build.gradle": "settings.gradle, gradle.properties, gradlew, gradlew.bat, libs.versions.toml",
        "build.gradle.kts": "settings.gradle.kts, gradle.properties, gradlew, gradlew.bat, libs.versions.toml",
        "CMakeLists.txt": "CMakePresets.json, CMakeUserPresets.json, CMakeCache.txt, compile_commands.json, .clang-format, .clang-tidy, .clangd",
        "Dockerfile": "Dockerfile.*, .dockerignore",
        "compose.yml": "compose.*.yml, compose.*.yaml",
        "compose.yaml": "compose.*.yml, compose.*.yaml",
        "docker-compose.yml": "docker-compose.*.yml, docker-compose.*.yaml",
        "docker-compose.yaml": "docker-compose.*.yml, docker-compose.*.yaml",
        ".env": ".env.*, .envrc, env.d.ts",
        ".gitignore": ".gitattributes, .gitmodules, .gitkeep, .mailmap, .ignore, .rgignore, .fdignore",
        "README.md": "README.*.md, CHANGELOG.md, CHANGES.md, CONTRIBUTING.md, CODE_OF_CONDUCT.md, SECURITY.md, LICENSE, LICENSE.*, COPYING, NOTICE, AUTHORS"
      },
      "telemetry.telemetryLevel": "off"
    }
  },
  "tasks": null,
  "detect": null
}
