// Consolidated v2.2 pack: containers (capability)
{
  "version": 2,
  "id": "containers",
  "kind": "capability",
  "description": "Container Tools (replaces deprecated ms-azuretools.vscode-docker)",
  "requires": [
    "core-editor"
  ],
  "defaultWith": [],
  "conflicts": [],
  "extensions": {
    "workspace": [
      "ms-azuretools.vscode-containers"
    ],
    "profile": [],
    "unwanted": [
      "ms-azuretools.vscode-docker"
    ]
  },
  "settings": {
    // Container Tools workspace settings: strict Dockerfile bug diagnostics and safe multiline formatting.
    "workspace": {
      "[dockerfile]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "docker.languageserver.formatter.ignoreMultilineInstructions": true,
      "docker.languageserver.diagnostics.instructionJSONInSingleQuotes": "error",
      "docker.languageserver.diagnostics.instructionCmdMultiple": "error",
      "docker.languageserver.diagnostics.instructionEntrypointMultiple": "error"
    },
    // Container Tools profile noise reduction.
    "profile": {
      "containers.showRemoteWorkspaceWarning": false,
      "containers.images.checkForOutdatedImages": false
    }
  },
  "tasks": null,
  "detect": null
}
