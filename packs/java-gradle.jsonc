// Consolidated v2.2 pack: java-gradle (toolchain)
{
  "version": 2,
  "id": "java-gradle",
  "kind": "toolchain",
  "description": "Java with Gradle build tool (mutually exclusive with java-maven; supersedes java-maven when both manifests exist)",
  "requires": [
    "java-base"
  ],
  "defaultWith": [],
  "conflicts": [
    "java-maven"
  ],
  "extensions": {
    "workspace": [
      "vscjava.vscode-gradle"
    ],
    "profile": [],
    "unwanted": [
      "naco-siren.gradle-language"
    ]
  },
  "settings": {
    // Gradle workspace settings (disables Maven import, configures Gradle Build Server + JUnit).
    "workspace": {
      "java.project.resourceFilters": ["\\.gradle", "build"],
      "java.gradle.buildServer.enabled": "on",
      "java.gradle.buildServer.openBuildOutput": "openOnBuildFailure",
      "java.import.gradle.enabled": true,
      "java.import.gradle.wrapper.enabled": true,
      "java.import.gradle.annotationProcessing.enabled": true,
      "java.import.gradle.offline.enabled": false,
      "java.import.maven.enabled": false,
      "gradle.autoDetect": "on",
      "gradle.reuseTerminals": "task",
      "java.test.config": {
        "name": "GradleJUnit",
        "workingDirectory": "${workspaceFolder}",
        "vmArgs": ["-ea"],
        "args": []
      },
      "java.test.defaultConfig": "GradleJUnit",
      "files.watcherExclude": {
        "**/build/**": true,
        "**/.gradle/**": true
      },
      "search.exclude": {
        "**/build/**": true,
        "**/.gradle/**": true
      },
      "[groovy]": {
        "editor.tabSize": 4
      },
      "[gradle]": {
        "editor.tabSize": 4
      },
      "[gradle-kotlin-dsl]": {
        "editor.tabSize": 4
      }
    },
    // Machine-scoped Gradle import arguments (forbidden in workspace settings).
    "profile": {
      "java.import.gradle.arguments": "--parallel --build-cache",
      "java.import.gradle.jvmArguments": "-Xms256m -Xmx2G -XX:MaxMetaspaceSize=512m -Dfile.encoding=UTF-8"
    }
  },
  "tasks": null,
  "detect": {
    "priority": 30,
    "fallback": false,
    "match": "any",
    "supersedes": [
      "java-maven"
    ],
    "rules": [
      {
        "type": "any_file",
        "paths": [
          "build.gradle",
          "build.gradle.kts"
        ]
      }
    ]
  },
  "retireOnSwitch": {
    "settings": [
      "java.maven.downloadSources",
      "maven.pomfile.autoUpdateEffectivePOM",
      "maven.terminal.useJavaHome",
      "maven.executable.preferMavenWrapper",
      "maven.completion.gavEnabled",
      "maven.dependency.enableConflictDiagnostics",
      "maven.view"
    ],
    "extensions": [
      "vscjava.vscode-maven"
    ]
  }
}
