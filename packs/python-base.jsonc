// Consolidated v2.2 pack: python-base (toolchain)
{
  "version": 2,
  "id": "python-base",
  "kind": "toolchain",
  "description": "Shared Python runtime, debugger, Python Environments (venv/uv), Ruff formatter/linter, and pytest configuration",
  "requires": [
    "core-editor"
  ],
  "defaultWith": [],
  "conflicts": [],
  "extensions": {
    "workspace": [
      "ms-python.python",
      "ms-python.debugpy",
      "ms-python.vscode-python-envs",
      "charliermarsh.ruff"
    ],
    "profile": [],
    "unwanted": [
      "ms-pyright.pyright"
    ]
  },
  "settings": {
    // Portable Python workspace settings (compatible with or without uv installed).
    "workspace": {
      "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [88, 100],
        "editor.codeActionsOnSave": {
          "source.fixAll.ruff": "explicit",
          "source.organizeImports.ruff": "explicit"
        }
      },
      "ruff.configurationPreference": "filesystemFirst",
      "python.languageServer": "None",
      "python.useEnvironmentsExtension": true,
      "python-envs.defaultEnvManager": "ms-python.python:venv",
      "python.testing.pytestEnabled": true,
      "python.testing.unittestEnabled": false,
      "python.testing.autoTestDiscoverOnSaveEnabled": true,
      "testing.automaticallyOpenPeekView": "failureInVisibleDocument",
      "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true
      },
      "files.watcherExclude": {
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.tox/**": true,
        "**/.nox/**": true,
        "**/*.egg-info/**": true,
        "**/htmlcov/**": true,
        "**/.hypothesis/**": true
      },
      "search.exclude": {
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.tox/**": true,
        "**/.nox/**": true,
        "**/*.egg-info/**": true,
        "**/htmlcov/**": true,
        "**/.hypothesis/**": true
      }
    },
    // Machine-scoped Python environment preferences (auto-routes through uv; clean shellStartup activation).
    "profile": {
      "python-envs.alwaysUseUv": true,
      "python-envs.terminal.autoActivationType": "shellStartup"
    }
  },
  "tasks": null,
  "detect": null
}
