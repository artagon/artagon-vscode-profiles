// Consolidated v2.2 pack: python (toolchain)
{
  "version": 2,
  "id": "python",
  "kind": "toolchain",
  "description": "Default Python toolchain with BasedPyright type checking (mutually exclusive with python-ty)",
  "requires": [
    "python-base"
  ],
  "defaultWith": [],
  "conflicts": [
    "python-ty"
  ],
  "extensions": {
    "workspace": [
      "detachhead.basedpyright"
    ],
    "profile": [],
    "unwanted": [
      "ms-pyright.pyright"
    ]
  },
  "settings": {
    // BasedPyright settings: balanced standard mode, selective inlay hints, and Ruff unused-symbol delegation.
    "workspace": {
      "basedpyright.analysis.typeCheckingMode": "standard",
      "basedpyright.analysis.diagnosticMode": "openFilesOnly",
      "basedpyright.analysis.autoImportCompletions": true,
      "basedpyright.analysis.autoSearchPaths": true,
      "basedpyright.analysis.useLibraryCodeForTypes": true,
      "basedpyright.analysis.inlayHints.variableTypes": false,
      "basedpyright.analysis.inlayHints.genericTypes": false,
      "basedpyright.analysis.inlayHints.functionReturnTypes": true,
      "basedpyright.analysis.inlayHints.callArgumentNames": true,
      "basedpyright.analysis.diagnosticSeverityOverrides": {
        "reportUnusedImport": "none",
        "reportUnusedVariable": "none"
      }
    },
    "profile": null
  },
  "tasks": null,
  "detect": {
    "priority": 50,
    "fallback": false,
    "match": "any",
    "supersedes": [],
    "rules": [
      {
        "type": "any_file",
        "paths": [
          "pyproject.toml",
          "requirements.txt",
          "setup.py",
          "setup.cfg",
          "uv.lock",
          ".python-version"
        ]
      }
    ]
  },
  "retireOnSwitch": {
    "settings": [
      "ty.diagnosticMode",
      "ty.completions.autoImport",
      "ty.inlayHints.variableTypes",
      "ty.inlayHints.callArgumentNames"
    ],
    "extensions": [
      "astral-sh.ty"
    ]
  }
}
