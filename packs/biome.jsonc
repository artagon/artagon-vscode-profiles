// Consolidated v2.2 pack: biome (toolchain)
{
  "version": 2,
  "id": "biome",
  "kind": "toolchain",
  "description": "Biome formatter and linter stack for TypeScript/JavaScript/JSON/CSS (mutually exclusive with ts-eslint-prettier)",
  "requires": [
    "ts-base"
  ],
  "defaultWith": [],
  "conflicts": [
    "ts-eslint-prettier"
  ],
  "extensions": {
    "workspace": [
      "biomejs.biome"
    ],
    "profile": [],
    "unwanted": []
  },
  "settings": {
    // Biome formatter and save actions (replaces ESLint + Prettier cleanly).
    "workspace": {
      "biome.enabled": true,
      "biome.requireConfiguration": true,
      "biome.suggestInstallingGlobally": false,
      "eslint.enable": false,
      "prettier.enable": false,
      "[javascript]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        }
      },
      "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        }
      },
      "[typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        }
      },
      "[javascriptreact]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        }
      },
      "[json]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
      },
      "[jsonc]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
      },
      "[css]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
      }
    },
    "profile": null
  },
  "tasks": null,
  "detect": {
    "priority": 22,
    "fallback": false,
    "match": "any",
    "supersedes": [
      "ts-eslint-prettier"
    ],
    "rules": [
      {
        "type": "any_file",
        "paths": [
          "biome.json",
          "biome.jsonc"
        ]
      }
    ]
  },
  "retireOnSwitch": {
    "settings": [
      "eslint.workingDirectories",
      "eslint.validate"
    ],
    "extensions": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode"
    ]
  }
}
