// Consolidated v2.2 pack: ts-base (toolchain)
{
  "version": 2,
  "id": "ts-base",
  "kind": "toolchain",
  "description": "Shared TypeScript/JavaScript base (Pretty TypeScript Errors, Vitest, tsserver tuning)",
  "requires": [
    "core-editor"
  ],
  "defaultWith": [
    "ts-eslint-prettier"
  ],
  "conflicts": [],
  "extensions": {
    "workspace": [
      "yoavbls.pretty-ts-errors",
      "vitest.explorer"
    ],
    "profile": [],
    "unwanted": [
      "christian-kohler.npm-intellisense",
      "christian-kohler.path-intellisense"
    ]
  },
  "settings": {
    // Shared TypeScript/JavaScript workspace settings (VS Code 1.147.0 unified js/ts.* schema, formatter-agnostic).
    "workspace": {
      "js/ts.updateImportsOnFileMove.enabled": "always",
      "js/ts.suggest.autoImports": true,
      "js/ts.tsserver.maxMemory": 4096,
      "js/ts.preferences.importModuleSpecifier": "project-relative",
      "js/ts.preferences.preferTypeOnlyAutoImports": true,
      "js/ts.preferGoToSourceDefinition": true,
      "js/ts.inlayHints.parameterNames.enabled": "literals",
      "js/ts.inlayHints.parameterNames.suppressWhenArgumentMatchesName": true,
      "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
      "js/ts.inlayHints.enumMemberValues.enabled": true,
      "files.watcherExclude": {
        "**/dist/**": true,
        "**/.next/**": true,
        "**/.turbo/**": true,
        "**/.vite/**": true,
        "**/coverage/**": true,
        "**/.pnpm-store/**": true
      },
      "search.exclude": {
        "**/dist/**": true,
        "**/.next/**": true,
        "**/.turbo/**": true,
        "**/.vite/**": true,
        "**/coverage/**": true,
        "**/.pnpm-store/**": true
      }
    },
    "profile": null
  },
  "tasks": null,
  "detect": {
    "priority": 26,
    "fallback": false,
    "match": "any",
    "supersedes": [],
    "rules": [
      {
        "type": "file",
        "path": "tsconfig.json"
      }
    ]
  }
}
