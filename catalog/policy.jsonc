// Consolidated v2.2 security policy, VS Code setting scopes, nested-safe autonomy
// deny-list rules, Default-profile audit expectations, UX managed keys, and
// Tier 1 privileged extension IDs.
{
  "version": 2,
  "vscodeVersion": "1.147.0",
  "forbiddenKeys": [
    "editor.hover.showDefinitionPreview",
    "editor.scrollbar.useShadows",
    "extensions.ignoreWorkspaceRecommendations",
    "terminal.integrated.fontLigatures",
    "workbench.tree.findMatchType",
    "inlineChat.enableV2",
    "antigravity.enableTelemetry",
    "chat.commandCenter.enabled",
    "chat.editor.renderWhitespace",
    "clangd.semanticHighlighting",
    "testing.openTesting",
    "testing.countBadge",
    "errorLens.maxProblemLength",
    "shellformat.path",
    "shellformat.flag",
    "rust-analyzer.typing.autoClosingAngleBrackets.enable",
    "rust-analyzer.inlayHints.reborrowHints.enable",
    "java.implementationsCodeLens.enabled",
    "java.sources.downloadSources",
    "java.sources.downloadJavadoc",
    "java.jdt.ls.javadoc.references.enabled",
    "java.test.editor.enableShortcuts",
    "java.import.gradle.java.homeFallback",
    "gradle.completion",
    "java.saveActions.organizeImports",
    "json.colorDecorators.enable",
    "scratchpads.useSubfolders",
    "ruff.nativeServer",
    "chat.tools.terminal.shellIntegrationTimeout",
    "chatgpt.runCodexInWindowsSubsystemForLinux"
  ],
  "autonomyDenyList": {
    "patterns": [
      "^chat\\.tools\\..*autoApprove$"
    ],
    "presenceKeys": [
      "claudeCode.claudeProcessWrapper",
      "claudeCode.environmentVariables",
      "antigravity.serverArgs",
      "antigravity.releaseBaseUrl",
      "antigravity.caCertificates",
      "chatgpt.cliExecutable"
    ],
    "presenceKeyPrefixes": [
      "terminal.integrated.profiles",
      "terminal.integrated.env",
      "terminal.integrated.automationProfile",
      "terminal.integrated.defaultProfile"
    ],
    "denyTrueKeys": [
      "claudeCode.allowDangerouslySkipPermissions",
      "geminicodeassist.agentYoloMode"
    ],
    "denyValues": {
      "claudeCode.initialPermissionMode": [
        "bypassPermissions",
        "acceptEdits"
      ]
    },
    "denyValueSubstrings": [
      "bypassPermissions",
      "--dangerously-skip-permissions"
    ]
  },
  "defaultProfileExpectations": {
    "telemetry.telemetryLevel": {
      "expected": "off",
      "type": "string",
      "reason": "Disable VS Code telemetry at application scope"
    },
    "security.workspace.trust.untrustedFiles": {
      "expected": "prompt",
      "type": "string",
      "reason": "Require explicit trust prompt before running tasks or extensions in untrusted workspaces"
    },
    "extensions.autoUpdate": {
      "expected": false,
      "type": "boolean",
      "reason": "Prevent automatic background updates from advancing install-time VSIX pins"
    }
  },
  "ux": {
    "managedKeys": [
      "editor.fontFamily",
      "editor.fontLigatures",
      "editor.fontSize",
      "editor.fontVariations",
      "editor.letterSpacing",
      "editor.lineHeight",
      "terminal.integrated.fontFamily",
      "terminal.integrated.fontSize",
      "window.density.editorTabHeight",
      "workbench.colorTheme",
      "workbench.fontAliasing",
      "workbench.iconTheme",
      "workbench.preferredDarkColorTheme",
      "workbench.productIconTheme",
      "workbench.tree.indent"
    ]
  },
  "tier1Privileged": [
    "anthropic.claude-code",
    "editorconfig.editorconfig",
    "github.copilot-chat",
    "google.google-antigravity",
    "mads-hartmann.bash-ide-vscode",
    "mkhl.shfmt",
    "openai.chatgpt",
    "redhat.vscode-xml",
    "redhat.vscode-yaml",
    "tamasfe.even-better-toml",
    "timonwong.shellcheck"
  ],
  "scopes": {
    "telemetry.telemetryLevel": {
      "type": "string",
      "enum": [
        "all",
        "error",
        "crash",
        "off"
      ],
      "scope": "application",
      "allowInCompiledProfile": true,
      "effectiveTarget": "default-profile"
    },
    "security.workspace.trust.untrustedFiles": {
      "type": "string",
      "enum": [
        "prompt",
        "open",
        "newWindow"
      ],
      "scope": "application",
      "allowInCompiledProfile": true,
      "effectiveTarget": "default-profile"
    },
    "window.titleBarStyle": {
      "type": "string",
      "enum": [
        "native",
        "custom"
      ],
      "scope": "application",
      "allowInCompiledProfile": true,
      "effectiveTarget": "default-profile"
    },
    "window.nativeTabs": {
      "type": "boolean",
      "scope": "application",
      "allowInCompiledProfile": true,
      "effectiveTarget": "default-profile"
    },
    "window.autoDetectHighContrast": {
      "type": "boolean",
      "scope": "application",
      "allowInCompiledProfile": true,
      "effectiveTarget": "default-profile"
    },
    "update.mode": {
      "type": "string",
